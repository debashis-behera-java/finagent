# ============================================================
# FINAGENT - Environment variable template
# Copy to `.env` and fill values. `.env` is git-ignored.
# ============================================================

# ---------- Phase 1: Application ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FINAGENT_APP_NAME=FinAgent
FINAGENT_APP_VERSION=1.0.0

# ---------- Phase 2: PostgreSQL (activate with SPRING_PROFILES_ACTIVE=postgres) ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finagent
SPRING_DATASOURCE_USERNAME=finagent
SPRING_DATASOURCE_PASSWORD=change-me

# ---------- Phase 3: Market data provider ----------
FINAGENT_MARKET_PROVIDER=stub            # stub | alpha-vantage
FINAGENT_MARKET_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=
FINAGENT_MARKET_TIMEOUT=5s
FINAGENT_MARKET_RETRY_ATTEMPTS=3
FINAGENT_MARKET_RETRY_BACKOFF=500ms

# ---------- Phase 4: Financial news provider ----------
FINAGENT_NEWS_PROVIDER=stub            # stub | newsapi
FINAGENT_NEWS_BASE_URL=https://newsapi.org
NEWS_API_KEY=
FINAGENT_NEWS_TIMEOUT=5s
FINAGENT_NEWS_RETRY_ATTEMPTS=2
FINAGENT_NEWS_RETRY_BACKOFF=500ms

# ---------- Phase 5: MCP server (Streamable HTTP at /mcp) ----------
# FINAGENT_MCP_ENABLED=true          # set false to disable the MCP endpoint entirely

# ---------- Phase 6: deterministic risk engine ----------
# FINAGENT_RISK_RISK_FREE_RATE=           # annual risk-free rate; unset => Sharpe unavailable
# FINAGENT_RISK_TRADING_DAYS_PER_YEAR=252
# FINAGENT_RISK_DEFAULT_BENCHMARK=SPY
# FINAGENT_RISK_BENCHMARK_PROVIDER=stub

# ---------- Phase 7: AI research agent (OpenAI chat model) ----------
SPRING_AI_OPENAI_API_KEY=            # required for real synthesis; tests/stub runs work without it
# FINAGENT_AI_MODEL=gpt-4o-mini
# FINAGENT_AI_TEMPERATURE=0.2
# FINAGENT_AI_MAX_TOKENS=800
# FINAGENT_AI_SYNTHESIS_TIMEOUT=60s   # hard bound per synthesis call (Phase 17)

# ---------- Phase 8: research orchestration (async jobs + history) ----------
# FINAGENT_RESEARCH_ENABLED=true      # set false to disable /api/v1/research* (dev profile default)
# FINAGENT_RESEARCH_CORE_POOL_SIZE=2
# FINAGENT_RESEARCH_MAX_POOL_SIZE=4
# FINAGENT_RESEARCH_QUEUE_CAPACITY=50

# ---------- Phase 9: news sentiment (lexicon baseline, offline) ----------
# FINAGENT_SENTIMENT_POSITIVE_THRESHOLD=0.2
# FINAGENT_SENTIMENT_NEGATIVE_THRESHOLD=-0.2
# FINAGENT_SENTIMENT_CONFIDENCE_HITS=5

# ---------- Phase 11: React dashboard (browser CORS; dev server also proxies /api) ----------
# FINAGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Phase 16: authentication (JWT) ----------
# FINAGENT_AUTH_ENABLED=true       # dev profile forces false (no database there)
# FINAGENT_AUTH_JWT_SECRET=        # REQUIRED in prod: >= 32 bytes, non-default.
#                                  # Generate: openssl rand -base64 48
# FINAGENT_AUTH_TOKEN_TTL=1h       # short-lived access tokens; no refresh tokens
# FINAGENT_AUTH_BCRYPT_STRENGTH=10
# FINAGENT_SWAGGER_ENABLED=true    # set false in production (prod profile default)
# FINAGENT_RATELIMIT_AUTH_MAX=10
# FINAGENT_RATELIMIT_AUTH_WINDOW=1m
# FINAGENT_RATELIMIT_RESEARCH_MAX=30
# FINAGENT_RATELIMIT_RESEARCH_WINDOW=1m

# ---------- Phase 16: production profile (SPRING_PROFILES_ACTIVE=prod) ----------
# Prod refuses to start with defaults. Required in the environment:
#   FINAGENT_AUTH_JWT_SECRET (real secret)
#   SPRING_AI_OPENAI_API_KEY (real key)
#   SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD (real password)
#   ALPHA_VANTAGE_API_KEY (only if FINAGENT_MARKET_PROVIDER=alpha-vantage)
#   NEWS_API_KEY (only if FINAGENT_NEWS_PROVIDER=newsapi)
#   FINAGENT_CORS_ALLOWED_ORIGINS (explicit origins, no localhost)
